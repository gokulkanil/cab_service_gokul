# Copy to .env and fill in. Blank values count as not set.

PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Website origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000

# Requests per minute per IP.
RATE_LIMIT_PER_MINUTE=120

# Supabase dashboard > Project Settings > API. Leave blank to serve seed content in development.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Secret (service role) key: server only, never in the website. Needed from Phase 1.
SUPABASE_SECRET_KEY=
