# Copy to .env.local and fill in once the Supabase project exists.
# Leave both empty to run on the seed content in supabase/seed/content.json.

# Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: where photos are served from. Defaults to the site-media bucket when
# Supabase is set, otherwise /images (the public/images folder).
NEXT_PUBLIC_MEDIA_BASE_URL=

# Backend API (apps/api). Used from Phase 1 for quotes, bookings and payments.
NEXT_PUBLIC_API_URL=http://localhost:4000
